# ===== 基础配置 =====
APP_NAME=律瞳 LegalLens
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8765

# ===== LLM 配置 =====
# MiniMax 国内版
LLM_PROVIDER=MiniMax
LLM_API_KEY=
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M3
LLM_THINKING=false
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4000

# ===== Embedding =====
# CPU 跑 BGE-M3 较慢（首次加载约 1-2 分钟），但能跑
EMBEDDING_DEVICE=cpu
EMBEDDING_USE_FP16=false
EMBEDDING_BATCH_SIZE=4

# ===== Qdrant =====
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_MODE=local
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=legal_knowledge

# ===== Obsidian =====
# OBSIDIAN_VAULT_PATH=C:/Users/YourName/Documents/MyVault
OBSIDIAN_WATCH_ENABLED=true
# 只允许在此目录及其子目录中配置 vault；未设置时远程配置会被拒绝
# OBSIDIAN_ALLOWED_ROOT=C:/Users/YourName/Documents/Obsidian

# ===== 运行模式 =====
ENVIRONMENT=development
TESTING=false

# ===== 合同审查 V2（默认关闭，可随时回退 V1）=====
CONTRACT_REVIEW_V2_ENABLED=false
CONTRACT_REVIEW_V2_PREVIEW_ENABLED=false
CONTRACT_REVIEW_V2_SHADOW_ENABLED=false

# ===== 合同生成 V1（尚未接入 LLM；默认关闭，仅限受控需求预览）=====
CONTRACT_GENERATION_V1_ENABLED=false
CONTRACT_GENERATION_V1_PREVIEW_ENABLED=false

# ===== 认证 =====
AUTH_BACKEND=local
# AUTH_BACKEND=aipath 时才需要设置
# AIPATH_DB_PATH=/opt/aipath-backend/backend/data/career.db
# 生产环境必须替换
JWT_SECRET=change-me
